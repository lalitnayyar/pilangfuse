# Output
OUTPUT_DIR=reports
PORT=3000

# Provider selection
WEB_SEARCH_PROVIDER=tavily
VIDEO_SEARCH_PROVIDER=youtube
ALLOW_PROVIDER_FALLBACK=true

# Retry behavior
HTTP_RETRY_COUNT=3
HTTP_RETRY_DELAY_MS=1200
HTTP_TIMEOUT_MS=30000

# Web search providers
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Video search providers
YOUTUBE_API_KEY=
# SERPAPI_API_KEY can also be used for YouTube fallback/provider

# Optional LLM summary for Agent 3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
